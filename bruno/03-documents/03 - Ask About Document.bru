meta {
  name: 03 - Ask About Document
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/documents/{{document_id}}/ask
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "question": "What is the interest rate mentioned in this agreement?"
  }
}

docs {
  Set "document_id" to a real uploaded document's ID first.
  Response includes sources scoped to only this document's chunks.
}
